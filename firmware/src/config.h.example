/* OODA Pomodoro puck — user configuration.
 *
 * Copy this file to `config.h` and fill in your values:
 *
 *     cp src/config.h.example src/config.h
 *
 * `config.h` is git-ignored (see firmware/.gitignore) so your WiFi password
 * and host token never get committed. Everything the firmware needs to reach
 * your OODA host lives here.
 */
#pragma once

// ── WiFi ────────────────────────────────────────────────────────────────────
#define WIFI_SSID       "your-wifi-name"
#define WIFI_PASSWORD   "your-wifi-password"

// ── OODA host (Remote control → "On — allow LAN devices") ────────────────────
// The IP of the machine running the OODA desktop app, and the control port.
// Default port is 7420 (settings.json → controlPort).
#define OODA_HOST       "192.168.1.50"
#define OODA_PORT       7420

// Shared token generated when you pick "On — allow LAN devices" in the tray
// menu (the copied URL contains it as ?token=…). Loopback wouldn't need one,
// but a puck talks over WiFi, so a token is required. Leave "" only if you are
// somehow on loopback.
#define OODA_TOKEN      "paste-your-token-here"

// ── Behavior tuning (sensible defaults; change freely) ───────────────────────
#define LONG_PRESS_MS   700     // hold time that counts as a long-press (→ skip)
#define PREVIEW_MIN_LO  5       // idle knob preview: min minutes
#define PREVIEW_MIN_HI  90      // idle knob preview: max minutes
#define PREVIEW_MIN_DEF 25      // idle knob preview: default minutes

// ── Pinout (ESP32 devkit defaults from firmware/README.md) ───────────────────
#define PIN_OLED_SDA    21
#define PIN_OLED_SCL    22
#define PIN_ENC_CLK     32      // encoder A
#define PIN_ENC_DT      33      // encoder B
#define PIN_ENC_SW      25      // encoder push switch
#define PIN_BUZZER      26      // passive buzzer +

// ── OLED ─────────────────────────────────────────────────────────────────────
#define OLED_WIDTH      128
#define OLED_HEIGHT     64
#define OLED_ADDR       0x3C    // common SSD1306 I²C address (0x3C or 0x3D)
